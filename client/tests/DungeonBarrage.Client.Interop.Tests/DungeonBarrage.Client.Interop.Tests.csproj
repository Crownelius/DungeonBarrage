<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless interop tests. No Godot dependency: these must run in CI and on a build agent that
    has never seen the engine (CLIENT_SPEC 20).
  -->
  <PropertyGroup>
    <RootNamespace>DungeonBarrage.Client.Interop.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Test naming is deliberately sentence-like; xUnit analyzers cover what matters here. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DungeonBarrage.Client.Interop\DungeonBarrage.Client.Interop.csproj" />
    <ProjectReference Include="..\..\src\DungeonBarrage.Client.Contracts\DungeonBarrage.Client.Contracts.csproj" />
  </ItemGroup>

  <!--
    The release native library and the frozen fixture corpus are copied next to the test binary.
    The fixtures are referenced from their canonical location rather than duplicated: a second copy
    would drift, and the whole point is that C# reproduces the *same* bytes Rust froze.
  -->
  <ItemGroup>
    <None Include="..\..\..\target\release\db_sim_ffi.dll"
          Condition="Exists('..\..\..\target\release\db_sim_ffi.dll')"
          Link="db_sim_ffi.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\tests\fixtures\matches\**\*.json"
          Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
